server:
  address: 'tcp://:9091'

totp:
  issuer: janus.x

# the VM's clock is already NTP-synced by the OS, and outbound NTP from the
# edge VLAN isn't an allowed flow — the probe would only warn on every start
ntp:
  disable_startup_check: true

authentication_backend:
  # no SMTP relay yet: reset links can't be delivered, and the filesystem
  # notifier would write them where anyone shoulder-surfing the VM sees them
  password_reset:
    disable: true
  ldap:
    implementation: lldap
    address: 'ldap://[fd22:1337:6769:70::2]:3890'
    base_dn: 'dc=x'
    user: 'uid=janus,ou=people,dc=x'

# OIDC provider for services whose clients can't traverse forward-auth but
# speak OIDC natively (voyager) — the app authenticates against janus itself,
# so TOTP still gates every login
identity_providers:
  oidc:
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
          {{ lookup('env', 'JANUS_OIDC_JWKS_KEY') | trim | indent(10) }}
    clients:
      # the digest is derived from the plaintext client secret (both in
      # 1Password); the plaintext goes into voyager's authentication UI
      - client_id: 'voyager'
        client_name: 'Audiobookshelf'
        client_secret: '{{ lookup('env', 'JANUS_OIDC_VOYAGER_CLIENT_SECRET_DIGEST') | trim }}'
        public: false
        authorization_policy: 'two_factor'
        require_pkce: true
        pkce_challenge_method: 'S256'
        redirect_uris:
          - 'https://voyager.x/auth/openid/callback'
          - 'https://voyager.x/auth/openid/mobile-redirect'
          - 'audiobookshelf://oauth'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
        token_endpoint_auth_method: 'client_secret_basic'

# default-deny: every service must declare its audience below, or nobody
# reaches it
access_control:
  default_policy: deny
  rules:
    # the forward-auth middleware sits on the whole :443 entrypoint, so the
    # portal hostnames pass through it too and must exempt themselves
    - domain:
        - 'janus.x'
        - 'auth.polaris.x'
        - 'auth.tycho.x'
        - 'auth.rosetta.x'
        - 'auth.lyra.x'
        - 'auth.unity.x'
        - 'auth.gaia.x'
        - 'auth.andromeda.x'
        - 'auth.voyager.x'
        - 'auth.proxmox.sol.x'
      policy: bypass
    # unity, gaia, proxmox, andromeda and qbittorrent enforce their own native
    # authentication (andromeda against tycho over LDAP — its TV/phone clients
    # can't traverse forward-auth; seerr logs in with andromeda accounts);
    # voyager's apps can't either — it authenticates in-app via OIDC (above)
    - domain:
        - 'unity.x'
        - 'gaia.x'
        - 'andromeda.x'
        - 'voyager.x'
        - 'proxmox.sol.x'
        - 'seerr.andromeda.x'
        - 'qbittorrent.andromeda.x'
      policy: bypass
    - domain:
        - 'polaris.x'
        - 'rosetta.x'
        - 'radarr.andromeda.x'
        - 'radarr-fr.andromeda.x'
        - 'sonarr.andromeda.x'
        - 'prowlarr.andromeda.x'
        - 'cleanuparr.andromeda.x'
      policy: two_factor
      subject: 'group:admins'
    - domain: 'tycho.x'
      policy: two_factor
    # no subject restriction: any tycho account may use the music UI (Music
    # Assistant has no user roles, so everyone sees the full UI)
    - domain: 'lyra.x'
      policy: two_factor

# one cookie per protected domain: sessions are deliberately independent
# (bare `x` is a public suffix, so a shared cookie is impossible anyway);
# every domain routed on :443 must appear here — janus 401s unknown domains
session:
  expiration: '7d'
  inactivity: '7d'
  cookies:
    - domain: 'janus.x'
      authelia_url: 'https://janus.x'
    - domain: 'polaris.x'
      authelia_url: 'https://auth.polaris.x'
    - domain: 'tycho.x'
      authelia_url: 'https://auth.tycho.x'
    - domain: 'rosetta.x'
      authelia_url: 'https://auth.rosetta.x'
    - domain: 'lyra.x'
      authelia_url: 'https://auth.lyra.x'
    - domain: 'unity.x'
      authelia_url: 'https://auth.unity.x'
    - domain: 'gaia.x'
      authelia_url: 'https://auth.gaia.x'
    # andromeda.x is not a public suffix (unlike bare x), so this one cookie
    # spans every {component}.andromeda.x — one portal, one session for the
    # whole media suite
    - domain: 'andromeda.x'
      authelia_url: 'https://auth.andromeda.x'
    # auth.voyager.x is also the OIDC issuer — logins for voyager land here
    - domain: 'voyager.x'
      authelia_url: 'https://auth.voyager.x'
    - domain: 'proxmox.sol.x'
      authelia_url: 'https://auth.proxmox.sol.x'

storage:
  local:
    path: /data/db.sqlite3

notifier:
  filesystem:
    filename: /data/notification.txt
